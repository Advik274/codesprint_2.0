# Copy this file to .env and fill in real values before a live event.
# .env is gitignored — never commit real credentials.

# Full admin panel password (Setup, Control, Reset, Backup — everything).
ADMIN_PASSWORD=change-me-before-event

# Zone-laptop password. Give this to Zone Operators instead of the admin
# password — it only unlocks zone capture actions, nothing else. If unset,
# it falls back to ADMIN_PASSWORD (works, but a lost zone laptop then leaks
# full admin access).
ZONE_PASSWORD=change-me-too

PORT=4000
NODE_ENV=production
